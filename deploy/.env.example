# Copy this file to .env on the CentOS server and update image names/secrets.

FRONTEND_IMAGE=ghcr.io/OWNER/robot-agent/frontend:latest
JAVA_BACKEND_IMAGE=ghcr.io/OWNER/robot-agent/java-backend:latest
PYTHON_AI_IMAGE=ghcr.io/OWNER/robot-agent/python-ai:latest

# Optional if your GHCR packages are private. Defaults to the repository owner in CI.
GHCR_USERNAME=OWNER
# GHCR_TOKEN=

FRONTEND_PORT=80

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=robot_agent
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PORT=3306

REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379

POSTGRES_DB=robot_vector
POSTGRES_USER=robot
POSTGRES_PASSWORD=change-me
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432

ROBOT_REDIS_ENABLED=true
ROBOT_VECTOR_ENABLED=true

JAVA_OPTS=-XX:MaxRAMPercentage=75.0
